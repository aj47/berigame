{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "berigame-site",
  "account_id": "9a4725557b2acbac23f3fba92d096149",
  "main": "site-worker.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "berigame.com", "custom_domain": true },
    { "pattern": "wiki.berigame.com", "custom_domain": true },
    // Shared branding can update without publishing a new game/API Worker.
    // Trailing wildcards also match cache-busting query strings.
    { "pattern": "beta.berigame.com/favicon*", "zone_name": "berigame.com" },
    { "pattern": "beta.berigame.com/apple-touch-icon.png*", "zone_name": "berigame.com" },
    { "pattern": "beta.berigame.com/icon.png*", "zone_name": "berigame.com" },
    { "pattern": "beta.berigame.com/logo.png*", "zone_name": "berigame.com" }
  ],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": { "enabled": false }
}
