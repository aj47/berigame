{
	"name": "berigame-frontend",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"dev": "vite",
		"build": "vite build && node scripts/generate-wiki.mjs",
		"preview": "vite preview",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"stdb:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path ../spacetimedb",
		"smoke": "tsx scripts/smoke.ts",
		"models:optimize": "node scripts/optimize-models.mjs",
		"agent:serve": "tsx agent-api/main.ts",
		"agent:setup": "tsx agent-api/cli.ts setup",
		"agent:invite": "tsx agent-api/cli.ts invite",
		"agent:revoke": "tsx agent-api/cli.ts revoke",
		"agent:test": "tsx --test agent-api/*.test.ts",
		"agent:integration": "tsx agent-api/integration.ts",
		"agent:typecheck": "../spacetimedb/node_modules/.bin/tsc -p agent-api/tsconfig.json"
	},
	"dependencies": {
		"@react-three/drei": "^9.122.0",
		"@react-three/fiber": "^8.18.0",
		"@simplewebauthn/browser": "^14.0.0",
		"@simplewebauthn/server": "^14.0.3",
		"@types/node": "^22.20.5",
		"@types/three": "^0.186.0",
		"arctic": "^3.7.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"spacetimedb": "^2.10.1",
		"three": "^0.186.1",
		"zustand": "^4.3.2"
	},
	"devDependencies": {
		"@gltf-transform/core": "^4.5.1",
		"@gltf-transform/extensions": "^4.5.1",
		"@gltf-transform/functions": "^4.5.1",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^14.3.1",
		"@types/react": "^18.0.27",
		"@types/react-dom": "^18.0.10",
		"@vitejs/plugin-react": "^6.1.2",
		"jsdom": "^26.1.0",
		"meshoptimizer": "^1.3.0",
		"tsx": "^4.23.13",
		"vite": "^8.3.2",
		"vitest": "^4.1.11"
	},
	"overrides": {
		"stats-gl": {
			"three": "$three"
		}
	}
}
