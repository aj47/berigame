# Include inside nginx's http {} block. Replace the domain, TLS paths and root.
# Example only: run nginx -t in your deployment before enabling it.
# API and SpacetimeDB must bind to loopback or be firewalled from the internet.
# Set BERIGAME_AGENT_ORIGIN=https://game.example.com and
# BERIGAME_AGENT_TRUSTED_PROXY_IPS=127.0.0.1 for this single, directly exposed proxy.
# If a CDN precedes nginx, configure trusted real-IP handling first; never trust
# arbitrary forwarded headers. Do not expose a second, unprotected database URL.

map $http_upgrade $berigame_connection {
    default upgrade;
    ''      close;
}
limit_req_zone $binary_remote_addr zone=berigame_api_ip:10m rate=3r/s;
limit_req_zone $server_name zone=berigame_api_global:1m rate=30r/s;
limit_req_zone $binary_remote_addr zone=berigame_db_ip:10m rate=10r/s;
limit_req_zone $server_name zone=berigame_db_global:1m rate=100r/s;
limit_conn_zone $binary_remote_addr zone=berigame_connections_ip:10m;
limit_conn_zone $server_name zone=berigame_connections_global:1m;

# Omit query strings, headers and bodies from access logs.
log_format berigame '$time_iso8601 $request_method $uri $status $request_time';

server {
    listen 443 ssl;
    server_name game.example.com;
    ssl_certificate /etc/letsencrypt/live/game.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/game.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/berigame/frontend/dist;

    access_log /var/log/nginx/berigame-access.log berigame;
    # Avoid routine rejection logs echoing request URLs or credentials in queries.
    error_log /var/log/nginx/berigame-error.log crit;
    server_tokens off;
    client_header_timeout 10s;
    client_body_timeout 5s;
    send_timeout 10s;
    keepalive_timeout 10s;
    large_client_header_buffers 2 8k;
    limit_req_status 429;
    limit_conn_status 429;
    error_page 429 = @berigame_slow_down;
    limit_conn berigame_connections_ip 16;
    limit_conn berigame_connections_global 256;

    location /api/agent/ {
        limit_req zone=berigame_api_ip burst=20 nodelay;
        limit_req zone=berigame_api_global burst=100 nodelay;
        client_max_body_size 4k;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
        proxy_pass http://127.0.0.1:3001;
    }

    # Raw game connections need limits too. These bound HTTP/WS handshakes and
    # open connections; they do not rate-limit messages inside an open WebSocket.
    location /v1/ {
        limit_req zone=berigame_db_ip burst=30 nodelay;
        limit_req zone=berigame_db_global burst=200 nodelay;
        client_max_body_size 16k;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $berigame_connection;
        proxy_connect_timeout 3s;
        proxy_read_timeout 75s;
        proxy_buffering off;
        proxy_pass http://127.0.0.1:3000;
    }

    location = /agent.md {
        types { }
        default_type text/plain;
        charset utf-8;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
    location @berigame_slow_down {
        default_type application/json;
        add_header Retry-After 5 always;
        add_header Cache-Control no-store always;
        return 429 '{"error":{"code":"rate_limited","message":"Wait before retrying."}}';
    }
}
